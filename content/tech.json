  },
  "backend": {
   "name": "后端",
   "short": "后端",
   "row": 2,
   "color": "#b06a5a",
   "desc": "缓存、异步、治理、连接池。让应用层在流量面前有结构，而不是靠加机器硬扛。"
  },
  "sre": {
   "name": "SRE",
   "short": "SRE",
   "row": 3,
   "color": "#6f9a86",
   "desc": "监控、容量、混沌、复盘。让系统在没人盯着的时候也不出事，出事时能快速收敛。"
  },
  "perf": {
   "name": "性能工程",
   "short": "性能",
   "row": 4,
   "color": "#8d7fb5",
   "desc": "IO 路径、火焰图、压测、成本。跨在三条路线之上的横切能力：同样的机器，压出更多吞吐。"
  },
  "algo": {
   "name": "算法工程",
   "short": "算法",
   "row": 5,
   "color": "#7f9ec9",
   "desc": "复杂度、缓存淘汰、TopK、频次统计、近似算法。把「能跑」变成「跑得省」：同样的机器，用对数据结构多吃一倍流量。"
  }
